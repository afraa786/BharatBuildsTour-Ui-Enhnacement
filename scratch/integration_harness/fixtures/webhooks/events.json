{
  "_comment": "Webhook event matrix.",
  "EVENTS": {
    "VALID_PAID": {
      "event": "payment.captured",
      "expected_status": 200,
      "expected_transition": "PAID",
      "amount": 1000,
      "currency": "INR"
    },
    "AUTHORIZED_ONLY": {
      "event": "payment.authorized",
      "expected_status": 200,
      "expected_transition": "NONE",
      "_comment": "AUTHORIZED is not PAID."
