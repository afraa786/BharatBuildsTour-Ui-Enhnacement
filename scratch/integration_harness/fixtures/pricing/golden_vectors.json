{
  "_comment": "Expanded pricing golden vectors including edge cases, precision limits, and float traps.",
  "vectors": [
    {
      "_comment": "Standard happy path, even numbers.",
      "inputs": {
        "unit_price_paise": 100000,
        "cost_unit_paise": 60000,
        "quantity": "2.000",
        "discount_bps": 1000,
        "gst_rate_bps": 1800,
        "max_discount_bps": 2000,
        "min_margin_bps": 2500
      },
      "expected": {
        "gross_paise": 200000,
        "discount_paise": 20000,
        "taxable_paise": 180000,
        "tax_paise": 32400,
        "line_total_paise": 212400,
        "approval_required": false,
        "approval_reasons": []
      }
    },
    {
      "_comment": "Odd paise fraction rounding (.5 exactly rounds up). 1500 * 1.5 = 2250. 2250 * 501 / 10000 = 112.725 -> 113. If using float, 112.725 might become 112.72499999999999 and round down.",
      "inputs": {
        "unit_price_paise": 1500,
        "cost_unit_paise": 500,
        "quantity": "1.500",
        "discount_bps": 501,
        "gst_rate_bps": 1800,
        "max_discount_bps": 1000,
        "min_margin_bps": 1000
      },
      "expected": {
        "gross_paise": 2250,
        "discount_paise": 113,
        "taxable_paise": 2137,
        "tax_paise": 385,
        "line_total_paise": 2522,
        "approval_required": false,
        "approval_reasons": []
      }
    },
    {
      "_comment": "Exact margin floor. Revenue=1000, Cost=800. Margin=20%. Floor=20%. Should NOT require approval.",
      "inputs": {
        "unit_price_paise": 1000,
        "cost_unit_paise": 800,
        "quantity": "1.000",
        "discount_bps": 0,
        "gst_rate_bps": 0,
        "max_discount_bps": 0,
        "min_margin_bps": 2000
      },
      "expected": {
        "gross_paise": 1000,
        "discount_paise": 0,
        "taxable_paise": 1000,
        "tax_paise": 0,
        "line_total_paise": 1000,
        "approval_required": false,
        "approval_reasons": []
      }
    },
    {
      "_comment": "1 bps below margin floor. Requires approval.",
      "inputs": {
        "unit_price_paise": 1000,
        "cost_unit_paise": 801,
        "quantity": "1.000",
        "discount_bps": 0,
        "gst_rate_bps": 0,
        "max_discount_bps": 0,
        "min_margin_bps": 2000
      },
      "expected": {
        "gross_paise": 1000,
        "discount_paise": 0,
        "taxable_paise": 1000,
        "tax_paise": 0,
        "line_total_paise": 1000,
        "approval_required": true,
        "approval_reasons": ["MARGIN_BELOW_FLOOR"]
      }
    },
    {
      "_comment": "Discount exactly hits cap. No approval.",
      "inputs": {
        "unit_price_paise": 1000,
        "cost_unit_paise": 500,
        "quantity": "1.000",
        "discount_bps": 1500,
        "gst_rate_bps": 0,
        "max_discount_bps": 1500,
        "min_margin_bps": 0
      },
      "expected": {
        "gross_paise": 1000,
        "discount_paise": 150,
        "taxable_paise": 850,
        "tax_paise": 0,
        "line_total_paise": 850,
        "approval_required": false,
        "approval_reasons": []
      }
    },
    {
      "_comment": "Discount 1 bps above cap. Requested discount must NOT be clipped; it prices exactly at the requested bps. Using a larger principal so 1500 bps vs 1501 bps yields a completely distinct paise amount (15000 vs 15010).",
      "inputs": {
        "unit_price_paise": 100000,
        "cost_unit_paise": 50000,
        "quantity": "1.000",
        "discount_bps": 1501,
        "gst_rate_bps": 0,
        "max_discount_bps": 1500,
        "min_margin_bps": 0
      },
      "expected": {
        "gross_paise": 100000,
        "discount_paise": 15010,
        "taxable_paise": 84990,
        "tax_paise": 0,
        "line_total_paise": 84990,
        "approval_required": true,
        "approval_reasons": ["DISCOUNT_EXCEEDS_CAP"]
      }
    },
    {
      "_comment": "100% discount resulting in zero net revenue. The contract mandates this is strictly INVALID, not merely a draft requiring approval.",
      "inputs": {
        "unit_price_paise": 1000,
        "cost_unit_paise": 100,
        "quantity": "1.000",
        "discount_bps": 10000,
        "gst_rate_bps": 1800,
        "max_discount_bps": 10000,
        "min_margin_bps": 0
      },
      "expected": {
        "error": "INVALID_REVENUE"
      }
    },
    {
      "_comment": "FLOAT TRAP: built-in round(2.5) -> 2. We use ROUND_HALF_UP so 2.5 -> 3.",
      "inputs": {
        "unit_price_paise": 25,
        "cost_unit_paise": 10,
        "quantity": "1.000",
        "discount_bps": 1000,
        "gst_rate_bps": 0,
        "max_discount_bps": 2000,
        "min_margin_bps": 0
      },
      "expected": {
        "gross_paise": 25,
        "discount_paise": 3,
        "taxable_paise": 22,
        "tax_paise": 0,
        "line_total_paise": 22,
        "approval_required": false,
        "approval_reasons": []
      }
    }
  ],
  "quote_level_summation_trap": {
    "_comment": "Tests that line-level tax summation is used, NOT quote-level rerounding. Three lines, each 10 paise taxable, 18% tax -> 1.8 -> 2 paise tax per line. Total tax = 2+2+2 = 6. Re-rounding total (30 * 18%) -> 5.4 -> 5. The total tax MUST be 6.",
    "lines": [
      { "taxable_paise": 10, "tax_paise": 2 },
      { "taxable_paise": 10, "tax_paise": 2 },
      { "taxable_paise": 10, "tax_paise": 2 }
    ],
    "expected_quote_subtotal": 30,
    "expected_quote_tax": 6,
    "expected_quote_total": 36
  }
}
