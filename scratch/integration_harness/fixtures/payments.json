{
  "_comment": "Payment API fixtures (POST /payments/create-link). Mocks Razorpay responses.",
  "VALID_ACCEPTED_QUOTE": {
    "expected_status": 201,
    "request": {
      "business_id": "b0000000-0000-4000-a000-000000000000",
      "run_id": "RFQ-1042-ALPHA",
      "quote_id": "q2222222-0000-4000-a000-000000000002",
      "quote_version": 2,
      "amount_paise": 10030
    },
    "response": {
      "payment_id": "p0000000-0000-4000-a000-000000000000",
      "status": "CREATED",
      "provider_link_id": "plink_Qa2rZ3t4y5u6i7",
      "payment_url": "https://rzp.io/i/testlink123"
    },
    "mock_razorpay_response": {
      "id": "plink_Qa2rZ3t4y5u6i7",
      "amount": 10030,
      "currency": "INR",
      "accept_partial": false,
      "status": "created",
      "short_url": "https://rzp.io/i/testlink123"
    }
  },
  "DRAFT_QUOTE_REJECTED": {
    "expected_status": 409,
    "request": {
      "business_id": "b0000000-0000-4000-a000-000000000000",
      "run_id": "RFQ-1042-ALPHA",
