# StockAware frontend configuration. Copy this file to .env.local.

# Public base URL of the FastAPI service. The browser calls it directly
# (CORS is configured on the backend). Never put secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# When true, contract-shaped mock data is returned only if the matching
# backend endpoint is missing/unreachable. Real backend responses always win.
# Set to false to force real backend calls only.
NEXT_PUBLIC_USE_MOCKS=true
