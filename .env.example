# Copy to .env and replace the password before starting Docker Compose.
ENVIRONMENT=local
LOG_LEVEL=INFO
POSTGRES_USER=stockaware
POSTGRES_PASSWORD=replace-with-a-unique-local-password
POSTGRES_DB=stockaware
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# Phase 2 internal-only commercial API gate. Leave unset to fail closed.
INTERNAL_BUSINESS_ID=
INTERNAL_SERVICE_TOKEN=

# Phase 4 Razorpay credentials; leave unset to fail closed. Use test-mode keys only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PREVIOUS_WEBHOOK_SECRET=
RAZORPAY_ACCOUNT_ID=

# Local demo PDF storage; directory is ignored by Git.
ARTIFACT_DIR=artifacts

# WhatsApp Cloud API (Meta) — business/admin number
WHATSAPP_BIZ_PHONE_NUMBER_ID=
WHATSAPP_BIZ_ACCESS_TOKEN=
WHATSAPP_BIZ_VERIFY_TOKEN=

# WhatsApp Cloud API (Meta) — test/buyer number
WHATSAPP_TEST_PHONE_NUMBER_ID=
WHATSAPP_TEST_ACCESS_TOKEN=
WHATSAPP_TEST_VERIFY_TOKEN=

# Meta application secret used to verify X-Hub-Signature-256 on webhook POSTs.
WHATSAPP_APP_SECRET=

# Comma-separated wa_id values (no +, e.g. 919876543210) treated as the owner/admin.
ADMIN_WHATSAPP_NUMBERS=

# Comma-separated WhatsApp phone_number_id values that are Manager/admin bot surfaces.
# Messages to these numbers never enter buyer ordering flow.
ADMIN_WHATSAPP_PHONE_NUMBER_IDS=

# Comma-separated phone_number_id:business_uuid pairs for multi-business WhatsApp routing.
# Example: 1234567890:00000000-0000-0000-0000-000000000001
WHATSAPP_PHONE_NUMBER_BUSINESS_IDS=
