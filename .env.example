# Copy to .env and replace the password before starting Docker Compose.
ENVIRONMENT=local
LOG_LEVEL=INFO
POSTGRES_USER=stockaware
POSTGRES_PASSWORD=replace-with-a-unique-local-password
POSTGRES_DB=stockaware
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# Add provider credentials only when those integrations are implemented.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
