# Copy to .env and replace the password before starting Docker Compose.
ENVIRONMENT=local
LOG_LEVEL=INFO
POSTGRES_USER=stockaware
POSTGRES_PASSWORD=replace-with-a-unique-local-password
POSTGRES_DB=stockaware
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# Phase 2 internal-only commercial API gate. Leave unset to fail closed.
INTERNAL_BUSINESS_ID=
INTERNAL_SERVICE_TOKEN=

# Phase 4 Razorpay credentials; leave unset to fail closed. Use test-mode keys only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PREVIOUS_WEBHOOK_SECRET=
RAZORPAY_ACCOUNT_ID=

# WhatsApp Cloud API (Meta) — business/admin number
WHATSAPP_BIZ_PHONE_NUMBER_ID=
WHATSAPP_BIZ_ACCESS_TOKEN=
WHATSAPP_BIZ_VERIFY_TOKEN=

# WhatsApp Cloud API (Meta) — test/buyer number
WHATSAPP_TEST_PHONE_NUMBER_ID=
WHATSAPP_TEST_ACCESS_TOKEN=
WHATSAPP_TEST_VERIFY_TOKEN=

# Comma-separated wa_id values (no +, e.g. 919876543210) treated as the owner/admin.
ADMIN_WHATSAPP_NUMBERS=
